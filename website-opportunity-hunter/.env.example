# ---------------------------------------------------------------------------
# Website Opportunity Hunter — environment
# Copy to .env and fill in. NEVER commit .env. Nothing here is prefixed
# NEXT_PUBLIC_, and that is deliberate: no key ever reaches the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (required) ---------------------------------------------------
DATABASE_URL=postgresql://woh:woh@localhost:5432/woh?schema=public

# --- Sessions (required) ---------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Queue -----------------------------------------------------------------
# redis = BullMQ worker process. inline = run jobs in-process (dev only).
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379

# --- Companies House Public Data API (free; required for real UK data) ------
# Register at https://developer.company-information.service.gov.uk/
# Auth is HTTP Basic: the API key is the username, the password is empty.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
# Conservative client-side throttle. Confirm the current published limit in the
# Companies House developer guidelines before raising it.
COMPANIES_HOUSE_RATE_LIMIT=600
COMPANIES_HOUSE_RATE_WINDOW_MS=300000

# --- Web search provider (optional; used for website/social discovery) ------
# One of: none | brave | google_cse
SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW_MS=60000

# --- Places provider (optional; reviews, rating, opening hours) -------------
# One of: none | google_places
PLACES_PROVIDER=none
GOOGLE_PLACES_API_KEY=

# --- Website analyzer ------------------------------------------------------
WEBSITE_FETCH_TIMEOUT_MS=12000
WEBSITE_MAX_BYTES=2500000
WEBSITE_ANALYSIS_TTL_HOURS=168
WEBSITE_USER_AGENT=WebsiteOpportunityHunter/0.1 (+https://example.com/bot; B2B research; contact: you@example.com)
RESPECT_ROBOTS_TXT=true

# --- AI (optional; used only where it adds value) --------------------------
# One of: none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MONTHLY_BUDGET_GBP=20

# --- Data retention (GDPR) -------------------------------------------------
DATA_RETENTION_DAYS=365
