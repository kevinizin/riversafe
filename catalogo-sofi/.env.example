# Produção (Vercel): BLOB_READ_WRITE_TOKEN é criado sozinho ao conectar o
# Blob ao projeto. As outras três são configuradas em Settings > Environment Variables.
#
# BLOB_READ_WRITE_TOKEN=...
ADMIN_USER=sofi
# Gere com: node scripts/hash-password.mjs 'SenhaForte123'
ADMIN_PASSWORD_HASH=
# 32+ caracteres aleatórios: openssl rand -base64 48
SESSION_SECRET=

# Testes locais sem Blob: guarda os dados numa pasta.
# LOCAL_STORE_DIR=./.data
