# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).
#
# Sem estas variáveis o site roda em MODO DEMONSTRAÇÃO: o catálogo mostra
# produtos de exemplo e o painel /admin fica desativado.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Nunca coloque a service_role key aqui: o sistema não precisa dela.
